{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/extract.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/extract",
      "dest": "api/extract.ts"
    },
    {
      "src": "/predict",
      "dest": "backend/main.py"
    },
    {
      "src": "/predict-batch",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
